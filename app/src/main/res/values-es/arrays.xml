    <!-- Suffixes relating a plural to its singular ("tomatoes"/"tomato"). -->
    <string-array name="ingredient_plural_suffixes">
        <item>s</item><item>es</item>
    </string-array>

    <!-- Spanish puts the head noun FIRST and marks the modifier: "aceite de oliva" → aceite,
         "pollo al curry" → pollo. Not "con": "arroz con leche" is a dessert, not rice. -->
    <string-array name="ingredient_head_connectors">
        <item>de</item><item>del</item><item>al</item><item>a</item>
    </string-array>

    <!-- Same-product groups, "|"-separated. Keep short: a wrong entry silently merges
         two real ingredients. -->
    <string-array name="ingredient_synonyms">
        <item>patata|papa</item>
        <item>pimienta|pimienta negra</item>
        <item>nata|crema de leche</item>
        <item>maicena|almidón de maíz|fécula de maíz</item>
        <item>bicarbonato|bicarbonato sódico|bicarbonato de sodio</item>
        <item>levadura química|levadura en polvo|polvo de hornear</item>
        <item>cebolleta|cebolla tierna</item>
        <item>zumo de limón|jugo de limón</item>
    </string-array>

    <!-- "Never the same" pairs, "|"-separated, exactly two per line. These block a staple from
         swallowing a named variety once head detection generalizes. -->
    <string-array name="ingredient_distinctions">
        <item>leche de coco|leche</item>
        <item>leche de almendras|leche</item>
        <item>leche de avena|leche</item>
        <item>leche de soja|leche</item>
        <item>leche condensada|leche</item>
        <item>leche evaporada|leche</item>
        <item>azúcar moreno|azúcar</item>
        <item>azúcar glas|azúcar</item>
        <item>azúcar avainillado|azúcar</item>
        <item>aceite de sésamo|aceite</item>
        <item>aceite de trufa|aceite</item>
        <item>vinagre balsámico|vinagre</item>
        <item>harina de arroz|harina</item>
        <item>harina de maíz|harina</item>
        <item>agua de azahar|agua</item>
        <item>pimienta de cayena|pimienta</item>
    </string-array>

    <!-- Starting points for the in-app browser, for households cooking in this language.
         Plain links: tapping one opens that site's own recipe section, the user browses and
         picks. Keep every entry answering 200, and prefer sites that publish schema.org
         JSON-LD (that is what the import reads). Leave the array out and the English board
         is used. -->
    <string-array name="discover_sites">
        <item>https://www.directoalpaladar.com/</item>
        <item>https://bonviveur.com/es/</item>
        <item>https://www.hogarmania.com/cocina/recetas/</item>
        <item>https://www.pequerecetas.com/recetas/</item>
        <item>https://www.javirecetas.com/</item>
        <item>https://www.recetasdesbieta.com/</item>
        <item>https://recetas.elperiodico.com/</item>
        <item>https://cookpad.com/es</item>
    </string-array>

    <!-- How a site spells its own name: "domain label|display name". Only needed where simple
         capitalization gets it wrong ("bbcgoodfood" would read "Bbcgoodfood"). Names the
         browser tile *and* the cookbook an imported recipe is filed under - one list, so the
         two can never drift apart. Merged across all languages. -->
    <string-array name="discover_site_names">
        <item>directoalpaladar|Directo al Paladar</item>
        <item>pequerecetas|PequeRecetas</item>
        <item>recetasdesbieta|Recetas de Sbieta</item>
        <item>elperiodico|El Periódico Recetas</item>
    </string-array>

    <!-- Words that mark an hour / a minute in a typed or imported cooking time
         ("1 hour 10 min"). Read only, never written: what a duration *reads* as is
         rendered by the platform (android.icu MeasureFormat, device locale). Merged across all
         languages, so a German recipe still parses on an English phone. -->
    <string-array name="duration_hours">
        <item>horas</item>
        <item>hora</item>
        <item>h</item>
        <item>hs</item>
    </string-array>
    <string-array name="duration_minutes">
        <item>minutos</item>
        <item>minuto</item>
        <item>min</item>
    </string-array>
</resources>
