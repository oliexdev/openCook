    <string-array name="grocery_kw_drinks">
        <item>water</item><item>juice</item><item>coffee</item><item>"tea"</item><item>cola</item>
        <item>soda</item><item>beer</item><item>wine</item><item>smoothie</item>
    </string-array>
    <string-array name="grocery_kw_spices">
        <item>salt</item><item>pepper</item><item>paprika</item><item>curry</item><item>cumin</item>
        <item>cinnamon</item><item>nutmeg</item><item>oregano</item><item>thyme</item><item>rosemary</item>
        <item>"soy sauce"</item><item>vinegar</item><item>mustard</item><item>ketchup</item><item>mayo</item>
        <item>broth</item><item>stock</item><item>"tomato paste"</item><item>vanilla</item><item>spice</item>
        <item>"olive oil"</item><item>"oil"</item><item>sauce</item>
    </string-array>
    <string-array name="grocery_kw_pantry">
        <item>noodle</item><item>spaghetti</item><item>pasta</item><item>rice</item><item>flour</item>
        <item>sugar</item><item>lentil</item><item>chickpea</item><item>couscous</item><item>oats</item>
        <item>oatmeal</item><item>muesli</item><item>cereal</item><item>"can "</item><item>canned</item>
        <item>"coconut milk"</item><item>"baking powder"</item><item>yeast</item><item>honey</item><item>jam</item>
        <item>chocolate</item><item>cocoa</item><item>polenta</item><item>semolina</item>
    </string-array>
    <string-array name="grocery_kw_dairy">
        <item>milk</item><item>cream</item><item>butter</item><item>yogurt</item><item>yoghurt</item>
        <item>quark</item><item>"cream cheese"</item><item>cheese</item><item>"egg"</item><item>mozzarella</item>
        <item>parmesan</item><item>feta</item><item>margarine</item>
    </string-array>

    <!-- Background staples the meal-planner excludes from the reuse score. -->
    <string-array name="ingredient_staples">
        <item>salt</item><item>"salt and pepper"</item><item>pepper</item><item>"black pepper"</item><item>"white pepper"</item>
        <item>oil</item><item>"olive oil"</item><item>"vegetable oil"</item><item>"sunflower oil"</item><item>"canola oil"</item>
        <item>butter</item><item>water</item><item>vinegar</item><item>sugar</item><item>flour</item>
        <item>broth</item><item>"vegetable broth"</item><item>"chicken broth"</item><item>stock</item><item>"stock cube"</item>
        <item>mustard</item><item>"tomato paste"</item><item>"soy sauce"</item>
        <item>paprika</item><item>nutmeg</item><item>honey</item>
        <item>"baking powder"</item><item>"vanilla sugar"</item><item>"dry yeast"</item><item>yeast</item>
    </string-array>

    <!-- Staples seeded into a new household's pantry (display spelling). -->
    <string-array name="pantry_defaults">
        <item>Salt</item><item>Pepper</item><item>Olive oil</item><item>Butter</item><item>Vinegar</item>
        <item>Sugar</item><item>Flour</item><item>Vegetable broth</item><item>Stock cube</item><item>Mustard</item>
        <item>Tomato paste</item><item>Soy sauce</item><item>Paprika</item><item>Nutmeg</item><item>Honey</item>
        <item>Baking powder</item><item>Vanilla sugar</item><item>Dry yeast</item>
    </string-array>

    <!-- Recognized measuring units (kept verbatim; never converted). Metric is universal. -->
    <string-array name="ingredient_units">
        <item>g</item><item>kg</item><item>mg</item><item>l</item><item>ml</item><item>cl</item><item>dl</item>
        <item>liter</item><item>litre</item><item>gram</item><item>kilogram</item>
        <item>cup</item><item>cups</item><item>tbsp</item><item>tbsps</item><item>tablespoon</item><item>tablespoons</item>
        <item>tsp</item><item>tsps</item><item>teaspoon</item><item>teaspoons</item><item>oz</item><item>lb</item>
        <item>lbs</item><item>pound</item><item>pounds</item><item>clove</item><item>cloves</item><item>pinch</item>
        <item>pinches</item><item>can</item><item>cans</item><item>slice</item><item>slices</item><item>bunch</item>
        <item>stick</item><item>sticks</item><item>package</item><item>packet</item><item>bag</item><item>jar</item>
        <item>handful</item><item>drop</item><item>drops</item><item>dash</item><item>pint</item><item>quart</item>
        <item>gallon</item><item>stalk</item><item>stalks</item><item>sprig</item><item>sprigs</item><item>head</item>
        <item>piece</item><item>pieces</item>
    </string-array>

    <!-- Main-protein keywords for the meal-planner variety scoring (substring match, lower-case).
         Grouped by a fixed canonical key; only the keywords are translated per language. -->
    <string-array name="protein_kw_poultry">
        <item>chicken</item><item>turkey</item><item>poultry</item>
    </string-array>
    <string-array name="protein_kw_fish">
        <item>fish</item><item>salmon</item><item>tuna</item><item>trout</item><item>shrimp</item><item>prawn</item>
    </string-array>
    <string-array name="protein_kw_mince">
        <item>mince</item>
    </string-array>
    <string-array name="protein_kw_pork">
        <item>pork</item><item>bacon</item>
    </string-array>
    <string-array name="protein_kw_beef">
        <item>beef</item><item>steak</item>
    </string-array>
    <string-array name="protein_kw_lamb">
        <item>lamb</item>
    </string-array>
    <string-array name="protein_kw_plant">
        <item>tofu</item><item>tempeh</item><item>seitan</item>
    </string-array>

    <!-- Legacy/import category words → the fixed category keys (exact match, lower-case).
         The keys themselves ("pasta", "meat", …) always match and need no entry here; add only
         the words your language uses when a recipe was imported or written by hand. -->
    <string-array name="cat_alias_pasta">
        <item>noodles</item><item>pastas</item>
    </string-array>
    <string-array name="cat_alias_meat">
        <item>meats</item><item>poultry</item>
    </string-array>
    <string-array name="cat_alias_fish">
        <item>seafood</item>
    </string-array>
    <string-array name="cat_alias_soup">
        <item>soups</item><item>stew</item>
    </string-array>
    <string-array name="cat_alias_vegetarian">
        <item>veggie</item><item>vegan</item>
    </string-array>
    <string-array name="cat_alias_salad">
        <item>salads</item>
    </string-array>
    <string-array name="cat_alias_dessert">
        <item>desserts</item><item>sweets</item>
    </string-array>
    <string-array name="cat_alias_other">
        <item>misc</item><item>miscellaneous</item>
    </string-array>

    <!-- Legacy/import meal words → the fixed meal-type keys (exact match, lower-case).
         The keys themselves ("breakfast", "lunch", "snack", "dinner") need no entry. -->
    <string-array name="mealtype_alias_breakfast">
        <item>morning</item><item>brunch</item>
    </string-array>
    <string-array name="mealtype_alias_lunch">
        <item>midday</item><item>noon</item>
    </string-array>
    <string-array name="mealtype_alias_snack">
        <item>cake</item><item>coffee</item><item>tea time</item>
    </string-array>
    <string-array name="mealtype_alias_dinner">
        <item>supper</item><item>evening</item>
    </string-array>

    <!-- Language mechanics for ingredient matching. All four are optional: leave a list out and
         the English/German fallback applies — nothing breaks, matching is just less precise. -->

    <!-- Measure and vague-amount words that leak into an ingredient *name* ("3 tbsp oil",
         "a pinch of salt"). Stripped before and after a leading number. Only words that never
         *start* a real ingredient name belong here. -->
    <string-array name="ingredient_leading_noise">
        <item>"a bit of"</item><item>"a little"</item><item>"a few"</item><item>"a pinch of"</item>
        <item>"a handful of"</item><item>about</item><item>approx.</item><item>approx</item><item>some</item>
        <item>g</item><item>kg</item><item>mg</item><item>ml</item><item>cl</item><item>l</item>
        <item>oz</item><item>lb</item><item>lbs</item><item>tbsp</item><item>tsp</item>
        <item>cup</item><item>cups</item><item>can</item><item>cans</item><item>jar</item>
        <item>pack</item><item>package</item><item>slice</item><item>slices</item>
        <item>clove</item><item>cloves</item><item>pinch</item><item>bunch</item>
        <item>stick</item><item>sticks</item><item>sprig</item><item>sprigs</item><item>drop</item><item>drops</item>
    </string-array>

    <!-- Words opening a trailing *use* phrase: "butter for frying" is still butter. -->
    <string-array name="ingredient_use_phrases">
        <item>to</item><item>for</item>
    </string-array>

    <!-- Suffixes relating a plural to its singular ("tomatoes"/"tomato"). -->
    <string-array name="ingredient_plural_suffixes">
        <item>s</item><item>es</item>
    </string-array>

    <!-- Words marking the modifier of a head-INITIAL compound ("huile d\'olive" → huile).
         English puts the head last, so this list is deliberately empty. -->
    <string-array name="ingredient_head_connectors" />

    <!-- Same-product groups, "|"-separated. Keep short: a wrong entry silently merges
         two real ingredients. -->
    <string-array name="ingredient_synonyms">
        <item>spring onion|scallion|green onion</item>
        <item>coriander|cilantro</item>
        <item>passata|sieved tomatoes|tomato passata</item>
        <item>baking soda|bicarbonate of soda</item>
        <item>cornstarch|corn flour</item>
    </string-array>

    <!-- "Never the same" pairs, "|"-separated, exactly two per line. These block a staple from
         swallowing a named variety once head detection generalizes. -->
    <string-array name="ingredient_distinctions">
        <item>coconut milk|milk</item>
        <item>almond milk|milk</item>
        <item>oat milk|milk</item>
        <item>buttermilk|milk</item>
        <item>brown sugar|sugar</item>
        <item>powdered sugar|sugar</item>
        <item>icing sugar|sugar</item>
        <item>vanilla sugar|sugar</item>
        <item>sesame oil|oil</item>
        <item>truffle oil|oil</item>
        <item>balsamic vinegar|vinegar</item>
        <item>rice flour|flour</item>
    </string-array>

    <!-- Starting points for the in-app browser, for households cooking in this language.
         Plain links: tapping one opens that site's own recipe section, the user browses and
         picks. Keep every entry answering 200, and prefer sites that publish schema.org
         JSON-LD (that is what the import reads). Leave the array out and the English board
         is used. -->
    <string-array name="discover_sites">
        <item>https://www.allrecipes.com/recipes/</item>
        <item>https://www.bbc.co.uk/food/recipes</item>
        <item>https://www.seriouseats.com/all-recipes-5117985</item>
        <item>https://www.simplyrecipes.com/</item>
        <item>https://www.epicurious.com/recipes-menus</item>
        <item>https://www.delish.com/cooking/recipe-ideas/</item>
        <item>https://www.jamieoliver.com/recipes/</item>
        <item>https://www.budgetbytes.com/category/recipes/</item>
        <item>https://www.tasteofhome.com/recipes/</item>
        <item>https://www.recipetineats.com/recipes/</item>
    </string-array>

    <!-- How a site spells its own name: "domain label|display name". Only needed where simple
         capitalization gets it wrong ("bbcgoodfood" would read "Bbcgoodfood"). Names the
         browser tile *and* the cookbook an imported recipe is filed under - one list, so the
         two can never drift apart. Merged across all languages. -->
    <string-array name="discover_site_names">
        <item>allrecipes|Allrecipes</item>
        <item>bbcgoodfood|BBC Good Food</item>
        <item>bbc|BBC Food</item>
        <item>seriouseats|Serious Eats</item>
        <item>simplyrecipes|Simply Recipes</item>
        <item>foodnetwork|Food Network</item>
        <item>epicurious|Epicurious</item>
        <item>delish|Delish</item>
        <item>jamieoliver|Jamie Oliver</item>
        <item>budgetbytes|Budget Bytes</item>
        <item>tasteofhome|Taste of Home</item>
        <item>recipetineats|RecipeTin Eats</item>
    </string-array>

    <!-- Words that mark an hour / a minute in a typed or imported cooking time
         ("1 hour 10 min"). Read only, never written: what a duration *reads* as is
         rendered by the platform (android.icu MeasureFormat, device locale). Merged across all
         languages, so a German recipe still parses on an English phone. -->
    <string-array name="duration_hours">
        <item>hours</item>
        <item>hour</item>
        <item>hrs</item>
        <item>hr</item>
        <item>h</item>
    </string-array>
    <string-array name="duration_minutes">
        <item>minutes</item>
        <item>minute</item>
        <item>mins</item>
        <item>min</item>
        <item>m</item>
    </string-array>
</resources>
