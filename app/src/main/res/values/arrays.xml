<!-- These are *vocabulary* lists, not positional arrays: each language names as many words as
     it needs, and they are unioned across languages at runtime. InconsistentArrays compares
     item counts between locales, which is meaningless here. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="InconsistentArrays">
    <!-- Default (English) grocery-aisle keyword lists. Substring match, lower-case; aisle order
         is fixed in code (first match wins). Items with spaces are quoted to keep them. -->
    <string-array name="grocery_kw_frozen">
        <item>frozen</item><item>"ice cream"</item><item>ice-cream</item>
    </string-array>
    <string-array name="grocery_kw_meat_fish">
        <item>chicken</item><item>turkey</item><item>beef</item><item>pork</item><item>bacon</item>
        <item>ham</item><item>sausage</item><item>salami</item><item>mince</item><item>"ground "</item>
        <item>steak</item><item>lamb</item><item>meat</item><item>salmon</item><item>tuna</item>
        <item>shrimp</item><item>prawn</item><item>fish</item><item>fillet</item><item>filet</item>
        <item>cod</item><item>trout</item>
    </string-array>
    <string-array name="grocery_kw_produce">
        <item>tomato</item><item>"bell pepper"</item><item>onion</item><item>garlic</item><item>carrot</item>
        <item>potato</item><item>lettuce</item><item>salad</item><item>cucumber</item><item>zucchini</item>
        <item>courgette</item><item>broccoli</item><item>cauliflower</item><item>spinach</item><item>leek</item>
        <item>mushroom</item><item>apple</item><item>banana</item><item>lemon</item><item>lime</item>
        <item>orange</item><item>berry</item><item>berries</item><item>avocado</item><item>ginger</item>
        <item>chili</item><item>chilli</item><item>parsley</item><item>basil</item><item>chives</item>
        <item>bean</item><item>"pea"</item><item>corn</item><item>pumpkin</item><item>eggplant</item>
        <item>aubergine</item><item>celery</item><item>arugula</item><item>rocket</item><item>pear</item>
        <item>grape</item><item>mango</item><item>herb</item><item>vegetable</item><item>fruit</item>
