    <!-- Language mechanics for ingredient matching. All four are optional: leave a list out and
         the English/German fallback applies — nothing breaks, matching is just less precise. -->

    <!-- Measure and vague-amount words that leak into an ingredient *name* ("3 tbsp oil",
         "a pinch of salt"). Stripped before and after a leading number. Only words that never
         *start* a real ingredient name belong here. -->
    <string-array name="ingredient_leading_noise">
        <item>"قليل من"</item><item>"القليل من"</item><item>بضع</item><item>"رشة من"</item>
        <item>"حفنة من"</item><item>حوالي</item><item>تقريبًا</item><item>نحو</item><item>بعض</item>
        <item>g</item><item>kg</item><item>mg</item><item>ml</item><item>cl</item><item>l</item>
        <item>غ</item><item>كغ</item><item>مل</item><item>جرام</item><item>جم</item>
        <item>أونصة</item><item>رطل</item><item>أرطال</item><item>"ملعقة كبيرة"</item><item>"ملعقة صغيرة"</item>
        <item>كوب</item><item>أكواب</item><item>علبة</item><item>علب</item><item>برطمان</item>
        <item>عبوة</item><item>باكيت</item><item>شريحة</item><item>شرائح</item>
        <item>فص</item><item>فصوص</item><item>رشة</item><item>ربطة</item>
        <item>عود</item><item>أعواد</item><item>غصن</item><item>أغصان</item><item>قطرة</item><item>قطرات</item>
    </string-array>

    <!-- Words opening a trailing *use* phrase: "butter for frying" is still butter. -->
    <string-array name="ingredient_use_phrases">
        <item>حسب</item><item>"من أجل"</item>
    </string-array>

    <!-- Suffixes relating a plural to its singular ("tomatoes"/"tomato"). Only the plain
         sound plural (معلب/معلبات): ة → ات (قطرة/قطرات) is handled in code, and broken plurals
         (شريحة/شرائح) cannot be a suffix rule — they belong in ingredient_synonyms. -->
    <string-array name="ingredient_plural_suffixes">
        <item>ات</item>
    </string-array>

    <!-- Words marking the modifier of a head-INITIAL compound ("huile d\'olive" → huile).
         English puts the head last, so this list is deliberately empty. -->
    <string-array name="ingredient_head_connectors" />

    <!-- Same-product groups, "|"-separated. Keep short: a wrong entry silently merges
         two real ingredients. -->
    <string-array name="ingredient_synonyms">
        <item>بصل أخضر|بصل ربيعي|بصيلات</item>
        <item>كزبرة|كزبرة خضراء</item>
        <item>بساتا|صلصة طماطم مصفاة|طماطم مصفاة</item>
