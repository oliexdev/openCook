    <!-- discover_sites is intentionally omitted: the default (English) board lists only English-language
         recipe sites, so a copy here added nothing for Arabic households. With the array absent the
         default list is used (see the note in values/arrays.xml). -->

    <!-- How a site spells its own name: "domain label|display name". Only needed where simple
         capitalization gets it wrong ("bbcgoodfood" would read "Bbcgoodfood"). Names the
         browser tile *and* the cookbook an imported recipe is filed under - one list, so the
         two can never drift apart. Merged across all languages. -->
    <string-array name="discover_site_names">
        <item>allrecipes|Allrecipes</item>
        <item>bbcgoodfood|BBC Good Food</item>
        <item>bbc|BBC Food</item>
        <item>seriouseats|Serious Eats</item>
        <item>simplyrecipes|Simply Recipes</item>
        <item>foodnetwork|Food Network</item>
        <item>epicurious|Epicurious</item>
        <item>delish|Delish</item>
        <item>jamieoliver|Jamie Oliver</item>
        <item>budgetbytes|Budget Bytes</item>
        <item>tasteofhome|Taste of Home</item>
        <item>recipetineats|RecipeTin Eats</item>
    </string-array>

    <!-- Words that mark an hour / a minute in a typed or imported cooking time
         ("1 hour 10 min"). Read only, never written: what a duration *reads* as is
         rendered by the platform (android.icu MeasureFormat, device locale). Merged across all
         languages, so a German recipe still parses on an English phone. -->
    <string-array name="duration_hours">
        <item>ساعات</item>
        <item>ساعة</item>
        <item>ساعتان</item>
        <item>ساعتين</item>
        <item>س</item>
    </string-array>
    <string-array name="duration_minutes">
        <item>دقائق</item>
        <item>دقيقة</item>
        <item>دقيقتان</item>
        <item>دقيقتين</item>
        <item>د</item>
